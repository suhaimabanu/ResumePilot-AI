# Copy to .env (project root or backend/) and fill in. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated models tried in order when the primary is overloaded / rate-limited / retired
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2

# DOCX -> PDF converter: auto | libreoffice | word   (auto prefers LibreOffice, falls back to MS Word on Windows)
PDF_CONVERTER=auto
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

MAX_UPLOAD_MB=10
SESSION_TTL_MINUTES=120
# WORKSPACE_DIR=   (defaults to the OS temp dir)
CORS_ORIGINS=http://localhost:3000

# Frontend (frontend/.env.local): where Next.js proxies /api/*
# BACKEND_URL=http://127.0.0.1:8000
